# Non-secret template ONLY; install separately as /etc/marketing-os/shadow/<WORKSPACE_UUID>.env
# Always validate permissions, workspace identity, network isolation and restore.
MOS_SERVICE_ENABLED=0
MOS_PREFLIGHT_ENABLED=0
MOS_PIPELINE_ENABLED=0
MOS_BRIDGE_MODE=OFF
MOS_SCHEDULED_SHADOW_ENABLED=0
MOS_SUPERVISOR_ENABLED=0
MOS_QUEUE_ENABLED=0
MOS_QUEUE_MODE=OFF
MOS_DLQ_ACTIVE_KEY_ID=unset
# Set MOS_RUNTIME_READ_DSN / MOS_RUNTIME_READ_DB_USER using this NONSECRET file.
# Set MOS_RUNTIME_WRITE_DSN / MOS_RUNTIME_WRITE_DB_USER using this NONSECRET file.
# Never place passwords, DLQ keys or HMAC secrets in this file or in GitHub.
